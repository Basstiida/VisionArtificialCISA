# Copia este archivo como .env en la Jetson y llena los valores reales.
# .env NO se sube a git (está en .gitignore); este .env.example sí, sin contraseñas.

RTSP_CAM1=rtsp://USUARIO:CONTRASEÑA@192.168.10.2:554/cam/realmonitor?channel=1&subtype=0
RTSP_CAM2=rtsp://USUARIO:CONTRASEÑA@192.168.10.4:554/cam/realmonitor?channel=1&subtype=0

# Opcional: solo si los modelos no están en la carpeta modelos/
# MODELO_AUTOBUS=modelos/bus_v3.engine
# MODELO_ZONA=modelos/modelo_vista_v3.engine
# MODELO_DIGITOS=modelos/modelo_digitos_v3.engine
